# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
GA_PROPERTY_ID="your-ga4-property-id"

# Server-side Firebase Admin credentials
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"

# Optional fallback to explicit credentials instead of GOOGLE_APPLICATION_CREDENTIALS
# FIREBASE_CLIENT_EMAIL="..."

# Per-app isolation within a shared Firebase project/bucket.
# Convention: use this app's folder-name slug (e.g. "path-ci-graphicdesign") for all three,
# so Firestore data, Storage uploads, and Cloud Functions don't collide with other PATH apps.
FIREBASE_DATABASE_ID="your-app-slug"
FIREBASE_ADMIN_DATABASE_ID="your-app-slug"
STORAGE_PATH_PREFIX="your-app-slug"

# RMIT VAL (AI alt-text review). Each admin normally enters their own key in the
# alt-text page (kept in that browser's localStorage); VAL_API_KEY is an optional
# server-side fallback. Content images are sent to this endpoint for review.
# VAL_API_KEY="..."
VAL_BASE_URL="https://val-npe.rmit.edu.au/api"
VAL_MODEL="gpt-5.6-sol"
VAL_REASONING_EFFORT="low"
